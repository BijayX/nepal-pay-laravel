{
    "name": "bijayx/nepal-pay-laravel",
    "description": "Khalti and eSewa payment gateways for Laravel behind one typed, verified API.",
    "keywords": ["laravel", "khalti", "esewa", "payment", "payment-gateway", "nepal"],
    "homepage": "https://github.com/BijayX/nepal-pay-laravel",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Bijay Shrestha",
            "homepage": "https://bijayastha.com.np"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "BijayX\\NepalPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BijayX\\NepalPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint",
        "lint": "pint --test",
        "analyse": "phpstan analyse --memory-limit=1G",
        "ci": [
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "BijayX\\NepalPay\\NepalPayServiceProvider"
            ],
            "aliases": {
                "NepalPay": "BijayX\\NepalPay\\Facades\\NepalPay"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
